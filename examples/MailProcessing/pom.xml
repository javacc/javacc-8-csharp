<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.javacc.generator.csharp</groupId>
    <artifactId>examples</artifactId>
    <version>1.1.0-SNAPSHOT</version>
  </parent>

  <groupId>org.javacc.generator.csharp.examples</groupId>
  <artifactId>mailprocessing</artifactId>
  <packaging>jar</packaging>

  <name>JavaCC C# code generator / examples / MailProcessing</name>

  <build>
    <plugins>

      <!-- clear the tests results files -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>clear-res-test</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>files</directory>
                  <includes>
                    <include>cpy.*,*.out,*.out.html</include>
                  </includes>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- compile and link distinct executables -->
      <plugin>
        <!-- allows to compile C# code on different architectures with different compilers/linkers -->
        <!-- standard maven lifecycle -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- setting compileSourceRoots to src/main/chsarp,target/gen.../csharp makes the plugin
             compile twice the .cs, in phases default-compile and default-testCompile to
             target/classes and target/test-classes; so used the build-helper-maven-plugin -->
          <compilerId>csharp</compilerId>
          <!-- unfortunately the build does not fail on errors... -->
          <failOnError>true</failOnError>
          <fork>true</fork>
          <verbose>true</verbose>
        </configuration>
        <executions>
        <!-- strange way to define 2 executions not exactly in the same manner (id, goal, phase) -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <compileSourceRoots>src/main/csharp/dig,target/generated-sources/csharp/dig</compileSourceRoots>
              <!-- compilerArguments raises a depecation warning but works, compilerArgs does not -->
              <compilerArguments>
                <nologo>true</nologo>
                <target>exe</target>
                <out>${project.artifactId}-digest.exe</out>
              </compilerArguments>
            </configuration>
          </execution>
          <execution>
            <id>comp-Faq</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>compile</phase>
            <configuration>
              <compileSourceRoots>src/main/csharp/faq,target/generated-sources/csharp/faq</compileSourceRoots>
              <!-- compilerArguments raises a depecation warning but works, compilerArgs does not -->
              <compilerArguments>
                <nologo>true</nologo>
                <target>exe</target>
                <out>${project.artifactId}-faq.exe</out>
              </compilerArguments>
            </configuration>
        </execution>
        </executions>
      </plugin>


      <!-- execute the tests -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>exec-Digest-test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skip.test.csharp.examples.MailProcessing.Digest}</skip> <!-- default false -->
              <executable>${project.basedir}/target/classes/${project.artifactId}-digest.exe</executable>
              <arguments>
                <argument>${project.basedir}/files/sampleMailFile.in</argument>
                <argument>${project.basedir}/files/digestFile.out</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>exec-Faq-test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${skip.test.csharp.examples.MailProcessing.Faq}</skip> <!-- default false -->
              <executable>${project.basedir}/target/classes/${project.artifactId}-faq.exe</executable>
              <arguments>
                <argument>1</argument>
                <argument>${project.basedir}/files/sampleMailFile.in</argument>
                <argument>${project.basedir}/files</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>


      <!-- check the tests results -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>check-Digest-test</id>
            <phase>test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <skip>${skip.test.csharp.examples.MailProcessing.Digest}</skip> <!-- default false -->
              <failOnError>${failOnError.check.csharp.examples.MailProcessing.Digest}</failOnError>
              <target>
                <!-- out -->
                <ant antfile="${project.basedir}/../../it/build-utils.xml" target="compare-out">
                  <property name="dir" value="${project.basedir}" />
                  <property name="file" value="digestFile" />
                </ant>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>check-Faq-test</id>
            <phase>test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <skip>${skip.test.csharp.examples.MailProcessing.Faq}</skip> <!-- default false -->
              <failOnError>${failOnError.check.csharp.examples.MailProcessing.Faq}</failOnError>
              <target>
                <!-- out index.out.html -->
                <ant antfile="${project.basedir}/../../it/build-utils.xml" target="compare-any">
                  <property name="dir" value="${project.basedir}" />
                  <property name="actual" value="index.out.html" />
                  <property name="expected" value="index.exp_out.html" />
                </ant>
                <!-- out 1.out.html -->
                <ant antfile="${project.basedir}/../../it/build-utils.xml" target="compare-any">
                  <property name="dir" value="${project.basedir}" />
                  <property name="actual" value="1.out.html" />
                  <property name="expected" value="1.exp_out.html" />
                </ant>
                <!-- out 2.out.html -->
                <ant antfile="${project.basedir}/../../it/build-utils.xml" target="compare-any">
                  <property name="dir" value="${project.basedir}" />
                  <property name="actual" value="2.out.html" />
                  <property name="expected" value="2.exp_out.html" />
                </ant>
                <!-- out 3.out.html -->
                <ant antfile="${project.basedir}/../../it/build-utils.xml" target="compare-any">
                  <property name="dir" value="${project.basedir}" />
                  <property name="actual" value="3.out.html" />
                  <property name="expected" value="3.exp_out.html" />
                </ant>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>