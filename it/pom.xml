    <profile>
      <!-- maven-compiler-plugin with plexus-compiler-csharp:  2024/07
           they assume the path to csc.exe is in the %PATH%;
           if it is not the case, set a new environment variable CscCompilerDir to this path
            (use dir /s %windir%\csc.exe and dir /s "%programfiles%\csc.exe"),
            so this profile will be activated and pick it to set the path to the executable  -->
      <id>csc-dir-env</id>
      <activation>
        <property>
          <name>env.CSCCOMPILERDIR</name>
        </property>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-compiler-plugin</artifactId>
              <version>${maven-compiler-plugin.version}</version>
              <dependencies>
                <dependency>
                  <groupId>org.codehaus.plexus</groupId>
                  <artifactId>plexus-compiler-csharp</artifactId>
                  <version>${plexus-compiler-csharp.version}</version>
                  <scope>runtime</scope>
                </dependency>
              </dependencies>
            </plugin>
          </plugins>
        </pluginManagement>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <dependencies>
              <dependency>
                <groupId>org.codehaus.plexus</groupId>
                <artifactId>plexus-compiler-csharp</artifactId>
                <version>${plexus-compiler-csharp.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <verbose>true</verbose>
              <compilerId>csharp</compilerId>
              <fork>true</fork>
              <executable>${env.CSCCOMPILERDIR}/csc.exe</executable>
              <compilerArguments>
                <target>exe</target>
                <nologo />
              </compilerArguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
