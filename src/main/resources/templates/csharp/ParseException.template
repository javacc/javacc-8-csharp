/**
 * The class generated by Javacc/csharp (by CodeGenerator.java with csharp/ParseException.template)
 *  that is used when parse errors are encountered.<br>
 * You can explicitly create objects of this exception type by calling the method
 *  generateParseException() in the generated parser.<br>
 * You can modify this class to customize your error reporting mechanisms
 *  so long as you retain the public fields.
 */
public partial class ParseException : System.Exception {

  /** The end of line string for this system. */
  protected static string EOL = System.Environment.NewLine;

  /**
   * This constructor is used by the method "generateParseException" in the generated parser.<br>
   * Calling this constructor generates a new object of this type with the fields "currentToken",
   *  "expectedTokenSequences", "tokenImage, "tokenLabel, "expectedExpansionLineVal"
   *  and "expectedExpansionColumnVal" set.
   */
  public ParseException(   Token currentTokenVal,
                         int[][] expectedTokenSequencesVal,
                        string[] tokenImageVal,
                        string[] tokenLabelVal,
                             int expectedExpansionLineVal,
                             int expectedExpansionColumnVal) :
         base(initialise(currentTokenVal, expectedTokenSequencesVal, tokenImageVal, tokenLabelVal, 
                         expectedExpansionLineVal, expectedExpansionColumnVal)) {
    currentToken = currentTokenVal;
    expectedTokenSequences = expectedTokenSequencesVal;
    tokenImage = tokenImageVal;
    tokenLabel = tokenLabelVal;
    expectedExpansionLine = expectedExpansionLineVal;
    expectedExpansionColumn = expectedExpansionColumnVal;
  }

  /*
   * The following constructors are for use by you for whatever purpose you can think of.
   * Constructing the exception in this manner makes the exception behave in the normal way
   *  - i.e., as documented in the class "Throwable".<br>
   * The fields "errorToken", "expectedTokenSequences", "tokenImage, "expectedExpansionLineVal" and
   *  "expectedExpansionColumnVal" do not contain relevant information.<br>
   * The JavaCC generated code does not use these constructors.
   */

  /** Constructor without message. */
  public ParseException() {
  }

  /** Constructor with message. */
  public ParseException(string message)  : base(message) {
  }


  /**
   * This is the last token that has been consumed successfully.<br>
   * If this object has been created due to a parse error,
   *  the token following this token will (therefore) be the first error token.
   */
  public Token currentToken;

  /**
   * Each entry in this array is an array of integers.<br>
   * Each array of integers represents a sequence of tokens (by their ordinal values)
   *  that is expected at this point of the parse.
   */
  public int[][] expectedTokenSequences;

  /**
   * This is a reference to the "tokenImage" array of the generated parser within which
   *  the parse error occurred.<br>
   * This array is defined in the generated ParserConstants class in the ParserTokenManager.cs file.
   */
  public string[] tokenImage;

  /**
   * This is a reference to the "tokenLabel" array of the generated parser within which
   *  the parse error occurred.<br>
   * This array is defined in the generated ParserConstants interface.
   */
  public string[] tokenLabel;

  /**
   * The beginning line of the expansion where the exception arose.
   */
  public int expectedExpansionLine;

  /**
   * The beginning column of the expansion where the exception arose.
   */
  public int expectedExpansionColumn;

  /**
   * Generate a parse error message and returns it.<br>
   * If this object has been created due to a parse error and you do not catch it
   *  (i.e. it gets thrown from the parser), the correct error message gets displayed.
   */
  private static string initialise(   Token currentToken,
                                    int[][] expectedTokenSequences,
                                   string[] tokenImage,
                                   string[] tokenLabel,
                                        int expectedExpansionLine,
                                        int expectedExpansionColumn) {

    string expected = string.Empty;
    int maxSize = 0;
    
    for (int i = 0; i < expectedTokenSequences.Length; i++) {
      int[] expTkSeq = expectedTokenSequences[i];
      if (maxSize < expTkSeq.Length) {
        maxSize = expTkSeq.Length;
      }
      for (int j = 0; j < expTkSeq.Length; j++) {
        if (j > 0) {
          expected += ' ';
        } else {
          expected += "    ";
       }
        expected += tokenImage[expTkSeq[j]];
      }
      if (expTkSeq[expTkSeq.Length - 1] != 0) {
        expected += "...";
      }
      expected += EOL;
    }
    string retval = "Encountered:";
    Token tok = currentToken.next;
    for (int i = 0; i < maxSize; i++) {
      retval += ' ';
      if (tok.kind == 0) {
        retval += tokenLabel[0];
        break;
      }
      retval += tokenLabel[tok.kind] + " / \"" + add_escapes(tok.image) + '"';
      tok = tok.next;
    }
#if KEEP_LINE_COLUMN
    retval += ", at line " + currentToken.next.beginLine;
    retval += ", column " + currentToken.next.beginColumn;
#fi
    retval += '.' + EOL;

    if (expectedTokenSequences.Length == 0) {
      // Nothing to add here
    } else {
	    if (expectedTokenSequences.Length == 1) {
	      retval += "Was expecting this terminal";
	    } else {
	      retval += "Was expecting one of these terminals";
	    }
#if KEEP_LINE_COLUMN
      retval += " within expansion starting at line " + expectedExpansionLine;
      retval += ", column " + expectedExpansionColumn;
#fi
      retval += ':' + EOL + expected.ToString();
    }
    return retval;
  }

  /**
   * Used to convert raw characters to their escaped version when these raw version
   *  cannot be used as part of an ASCII string literal.
   */
  public static string add_escapes(string str) {
      string retval = string.Empty;
      char ch;
      for (int i = 0; i < str.Length; i++) {
        switch (str[i])
        {
           case '\b':
              retval += "\\b";
              continue;
           case '\t':
              retval += "\\t";
              continue;
           case '\n':
              retval += "\\n";
              continue;
           case '\f':
              retval += "\\f";
              continue;
           case '\r':
              retval += "\\r";
              continue;
           case '\"':
              retval += "\\\"";
              continue;
           case '\'':
              retval += "\\\'";
              continue;
           case '\\':
              retval += "\\\\";
              continue;
           default:
              if ((ch = str[i]) < 0x20 || ch > 0x7e) {
                 retval += "\\u" +  ((int) ch).ToString("X4");
              } else {
                 retval += ch;
              }
              continue;
        }
      }
      return retval.ToString();
   }

} // end class

#if NAMESPACE
} // end namespace
#fi
