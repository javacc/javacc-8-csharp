  /* Lookahead phases and token scan return codes. */

  public const bool LA_Phase2_Failure = false;
  public const bool LA_Phase2_Success = true;
  public const bool LA_Phase3_Failure = true;
  public const bool LA_Phase3_Success = false;
  public const bool LA_Scan_Token_Failure = true;
  public const bool LA_Scan_Token_Success = false;

  /** True when the last scan matches, thus making the lookahead successful. */
  private bool jj_laok  = false;
  
  /** Generated or User defined TokenManager. */
  public ${parserName}TokenManager token_source;
  
  /** Generated or User defined input char stream. */
  ${JAVA_UNICODE_ESCAPE?Java:Simple}CharStream jj_input_stream;
  
  /** Current token. */
  public Token token;

  /** Next token. */
  public Token jj_nt;
  
  private int jj_ntk;
  private Token jj_scanpos, jj_lastpos;
  private int jj_la;
  private int jj_gen;
  private bool hasError = false;

  /** Whether we are looking ahead or not (impacts getToken(int i)). */
  private bool jj_lookingAhead = false;
  
  /* Whether we have a semantic looking ahead or not. */
  private bool jj_semLA = false;

  /** Constructor. */
  public ${parserName}(System.IO.TextReader stream) {
    jj_input_stream = new ${JAVA_UNICODE_ESCAPE?Java:Simple}CharStream(stream, 1, 1);
    token_source = new ${parserName}TokenManager(jj_input_stream);
    token = new Token();
    jj_ntk = -1;
    jj_gen = 0;
#if ERROR_REPORTING
    for (int i = 0; i < jj_la1.Length; i++) {
      jj_la1[i]     = -1;
      jj_la1_loc[i] = null;
    }
    for (int i = 0; i < jj_2_rtns.Length; i++) {
      jj_2_rtns[i] = new JJCalls();
    }
#fi
    hasError = false;
#if DEBUG_PARSER
    enable_tracing();
#fi
#if DEBUG_LOOKAHEAD
    enable_la_tracing();
#fi
  }

  /** Reinitialise. */
  public void ReInit(System.IO.TextReader stream) {
    if (jj_input_stream == null) {
      jj_input_stream = new ${JAVA_UNICODE_ESCAPE?Java:Simple}CharStream(stream, 1, 1);
    } else {
      jj_input_stream.ReInit(stream, 1, 1);
    }
    if (token_source == null) {
      token_source = new ${parserName}TokenManager(jj_input_stream);
    }
    token_source.ReInit(jj_input_stream);
    token = new Token();
    jj_ntk = -1;
    jj_gen = 0;
#if ERROR_REPORTING
    for (int i = 0; i < jj_la1.Length; i++) {
      jj_la1[i]     = -1;
      jj_la1_loc[i] = null;
    }
    for (int i = 0; i < jj_2_rtns.Length; i++) {
      jj_2_rtns[i] = new JJCalls();
    }
#fi
    hasError = false;
#if DEBUG_PARSER
    enable_tracing();
#fi
#if DEBUG_LOOKAHEAD
    enable_la_tracing();
#fi
  }

