  /** Lookahead trace for a scanned (visited) token. */
  protected void trace_scan(Token t1, int k2) {
    if (traceLaEnabled) {
      for (int i = 0; i < trace_indent; i++) { System.Console.Out.Write(" "); }
      System.Console.Out.Write("Visited token (la=" + jj_la + "): " + disp_token(t1));
#if KEEP_LINE_COLUMN
      System.Console.Out.Write(", @ " + t1.beginLine + ":" + t1.beginColumn);
#fi
      System.Console.Out.WriteLine("; Expected token: <" + k2 + " / " + tokenImage[k2] + "> (la)");
    }
  }

