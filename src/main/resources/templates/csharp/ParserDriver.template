#if ERROR_REPORTING
  private Token jj_consume_token(int kind, string loc)  {
#else
  private Token jj_consume_token(int kind)  {
#fi
    Token oldToken = token;
    if (token.next != null) {
      token = token.next;
    } else {
      token = token.next = token_source.getNextToken();
    }
    jj_ntk = -1;
    if (token.kind == kind) {
#if ERROR_REPORTING
      jj_gen++;
      if (++jj_gc > MAX_NB_POS) {
        jj_gc = 0;
        for (int i = 0; i < jj_2_rtns.Length; i++) {
          JJCalls c = jj_2_rtns[i];
          while (c != null) {
            if (c.gen < jj_gen) c.first = null;
            c = c.next;
          }
        }
      }
#fi
#if DEBUG_PARSER
      trace_consumed(token, " (in jj_consume_token())");
#fi
      return token;
    }
#if DEBUG_LOOKAHEAD
    if (kind >= 0) trace_expected(kind, token, loc);
#fi
    token = oldToken;
#if ERROR_REPORTING
    jj_kind = kind;
    throw generateParseException(loc);
#else
    throw generateParseException();
#fi
  }

  /** Scans for a token of a given expected kind, returning success or failure. */
#if ERROR_REPORTING
  private bool jj_scan_token(int kind, string loc) {
#else
  private bool jj_scan_token(int kind) {
#fi
    if (jj_scanpos == jj_lastpos) {
      jj_la--;
      if (jj_scanpos.next == null) {
        jj_lastpos = jj_scanpos = jj_scanpos.next = token_source.getNextToken();
      } else {
        jj_lastpos = jj_scanpos = jj_scanpos.next;
      }
    } else {
      jj_scanpos = jj_scanpos.next;
    }
#if ERROR_REPORTING
    if (jj_rescan) {
      int i = 0;
      Token tok = token;
      while (tok != null && tok != jj_scanpos) {
        i++;
        tok = tok.next;
      }
      if (tok != null) {
        jj_add_error_token(kind, i, loc);
      }
#if DEBUG_LOOKAHEAD
    } else {
      trace_scan(jj_scanpos, kind);
#fi
    }
#elif DEBUG_LOOKAHEAD
    trace_scan(jj_scanpos, kind);
#fi
    if (jj_scanpos.kind != kind) {
      return LA_Scan_Token_Failure;
    }
    if (jj_la == 0 && jj_scanpos == jj_lastpos) {
      return jj_laok = LA_Scan_Token_Success;
    }
    return LA_Scan_Token_Success;
  }

/** Get the next Token. */
  public Token getNextToken() {
    if (token.next != null) token = token.next;
    else token = token.next = token_source.getNextToken();
    jj_ntk = -1;
    jj_gen++;
#if DEBUG_PARSER
    trace_consumed(token, " (in getNextToken())");
#fi
    return token;
  }

/** Get the specific Token. */
  public Token getToken(int index) {
    Token t = jj_lookingAhead ? jj_scanpos : token;
    for (int i = 0; i < index; i++) {
      if (t.next != null) t = t.next;
      else t = t.next = token_source.getNextToken();
    }
    return t;
  }

  private int jj_ntk_f() {
    if ((jj_nt=token.next) == null)
      return (jj_ntk = (token.next=token_source.getNextToken()).kind);
    else
     return (jj_ntk = jj_nt.kind);
  }

#if DEBUG_PARSER || DEBUG_LOOKAHEAD
  /** Parser & lookahead tracing indentation. */
  private int trace_indent = 0;
  
  /** Display a token with a convenient format. */
  protected string disp_token(Token t) {
    string s = "<" + t.kind + " / " + tokenImage[t.kind];
    if (t.kind != 0 && !tokenImage[t.kind].Equals(t.image)) {
      s += " / \"" + TokenMgrError.addEscapes(t.image) + "\"";
    }
    s += ">";
    return s;
  }

#fi
#if DEBUG_PARSER
  /** Parser tracing flag. */
  private bool traceEnabled;

  /** Is parser tracing enabled. */
  public bool trace_enabled() {
   return traceEnabled;
  }

  /** Enable parser tracing. */
  public void enable_tracing() {
   traceEnabled = true;
  }

  /** Disable parser tracing. */
  public void disable_tracing() {
   traceEnabled = false;
  }

  /** Parser trace on method entry. */
  protected void trace_call(string s) {
    if (traceEnabled) {
      for (int i = 0; i < trace_indent; i++) { System.Console.Out.Write(" "); }
      System.Console.Out.WriteLine("Call:   " + trace_indent + ": " + s + " (pa)");
    }
    trace_indent = trace_indent + 2;
  }

  /** Parser trace on method exit. */
  protected void trace_return(string s) {
    trace_indent = trace_indent - 2;
    if (traceEnabled) {
      for (int i = 0; i < trace_indent; i++) { System.Console.Out.Write(" "); }
      System.Console.Out.WriteLine("Return: " + trace_indent + ": " + s + " (pa)");
    }
  }

  /** Parser trace for a consumed token. */
  protected void trace_consumed(Token t, string where) {
    if (traceEnabled) {
      for (int i = 0; i < trace_indent; i++) { System.Console.Out.Write(" "); }
      System.Console.Out.Write("Consumed token: " + disp_token(t));
#if KEEP_LINE_COLUMN
      System.Console.Out.Write(", @ " + t.beginLine + ":" + t.beginColumn);
#fi
      System.Console.Out.WriteLine(where + " (pa)");
    }
  }

  /** Parser trace for an expected but not matched token. */
  protected void trace_expected(int k1, Token t2, string loc) {
    if (traceEnabled) {
      for (int i = 0; i < trace_indent; i++) { System.Console.Out.Write(" "); }
      System.Console.Out.Write("Expected token: <" + k1);
      if (k1 >= 0) System.Console.Out.Write(" / " + tokenImage[k1]);
      System.Console.Out.Write(">");
#if KEEP_LINE_COLUMN
      System.Console.Out.Write(", @ " + loc);
#fi
      System.Console.Out.WriteLine(" not matched by consumed token: " + disp_token(t2) + " (pa)");
    }
  }

#else
  /** No parser tracing enabled. */
  public bool trace_enabled() {
   return false;
  }

  /** Empty enable method for when no parser tracing. */
  public void enable_tracing() {
  }

  /** Empty disable method for when no parser tracing. */
  public void disable_tracing() {
  }

#fi
