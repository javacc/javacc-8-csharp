#if ERROR_REPORTING
  private int jj_kind = -1;
  private JJCalls[] jj_2_rtns = new JJCalls[${jj2index}];
  private bool jj_rescan = false;
  private int jj_gc = 0;

  private void jj_save(int index, int xla) {
    // to avoid "if (0 > 0)" that will give a warning: "dead code detected"
    int ix = ${jj2index};
    if (ix > 0) {
      JJCalls p = jj_2_rtns[index];
      while (p.gen > jj_gen) {
        if (p.next == null) {
          p = p.next = new JJCalls();
          break;
        }
        p = p.next;
      }
      p.gen   = jj_gen + xla - jj_la; 
      p.first = token;
      p.arg   = xla;
    }
  }

  internal partial class JJCalls {
    internal int gen;
    internal Token first;
    internal int arg;
    internal JJCalls next;
  }

  private void jj_rescan_token() {
    jj_rescan = true;
    for (int i = 0; i < ${jj2index}; i++) {
      JJCalls p = jj_2_rtns[i];
      while (p != null) {
        if (p.gen > jj_gen) {
          jj_la = p.arg; jj_lastpos = jj_scanpos = p.first;
          System.Type thisType = this.GetType();
          System.Reflection.MethodInfo theMethod = thisType.GetMethod(
              "jj_3_" + (i + 1),
              System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
          if (theMethod != null)
            theMethod.Invoke(this, new object[0]);
        }
        p = p.next;
      }
    }
    jj_rescan = false;
  }

  private System.Collections.Generic.List<int[]> jj_expentries        = new System.Collections.Generic.List<int[]>();
  private System.Collections.Generic.List<string[]> jj_expentries_loc = new System.Collections.Generic.List<string[]>();
  private int[]     jj_expentry;
  private string[]  jj_expentry_loc;
  private const int MAX_NB_POS        = 100;
  private int[]     jj_lasttokens     = new int[MAX_NB_POS];
  private string[]  jj_lasttokens_loc = new string[MAX_NB_POS];
  private int       jj_endpos;

  private void jj_add_error_token(int kind, int pos, string loc) {
    if (pos >= MAX_NB_POS) {
      return;
    }

    if (pos == jj_endpos + 1) {
      jj_lasttokens[jj_endpos]     = kind;
      jj_lasttokens_loc[jj_endpos] = loc;
      jj_endpos++;
    } else if (jj_endpos != 0) {
      jj_expentry     = new int[jj_endpos];
      jj_expentry_loc = new string[jj_endpos];
      for (int i = 0; i < jj_endpos; i++) {
        jj_expentry[i]     = jj_lasttokens[i];
        jj_expentry_loc[i] = jj_lasttokens_loc[i];
      }
      foreach (int[] oldentry in jj_expentries) {
        if (oldentry.Length == jj_expentry.Length) {
          bool isMatched = true;
          for (int i = 0; i < jj_expentry.Length; i++) {
            if (oldentry[i] != jj_expentry[i]) {
              isMatched = false;
              break;
            }
          }
          if (isMatched) {
            jj_expentries.Add(jj_expentry);
            jj_expentries_loc.Add(jj_expentry_loc);
            break;
          }
        }
      }
      if (pos != 0) {
        jj_lasttokens[pos - 1]     = kind;
        jj_lasttokens_loc[pos - 1] = loc;
        jj_endpos = pos;
      }
    }
  }
#fi
