  /* Reinitialise parser. */
#if TOKEN_MANAGER_USES_PARSER
  public void ReInit( ${parserName} parserArg, ${charStreamName} stream, int lexState) {
#else
  public void ReInit(${charStreamName} stream, int lexState) {
