/*
 * The class generated by JavaCC/csharp (by TokenManagerGenerator.java
 *  with csharp/TokenManagerDriver.template) that tokenizes input for the parser.
 */
public partial class ${parserName}TokenManager : ${tmSuperClass?${tmSuperClass}, :}${parserName}Constants {

  protected ${charStreamName} input_stream;
  protected int curChar;

  private int defaultLexState = ${defaultLexState};
  private int curLexState     = ${defaultLexState};

  private int jjmatchedPos;
  private int jjmatchedKind;
  private int lengthOfMatch;

  private string jjimage = string.Empty;
  private string image   = string.Empty;
  private int    jjimageLen;

// Beginning of user token manager declarations
${decls}
// End of user token manager declarations

#if TOKEN_MANAGER_USES_PARSER
  /* Constructor with parser. */
